<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contentScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/warehouse_relabeling"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="@string/settings"
                android:padding="11dp"
                android:src="@drawable/ic_settings_24"
                android:tint="@color/brand" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/takePhotoButton"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/primary_button_background"
                android:elevation="0dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/take_photo"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/choosePhotoButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/secondary_button_background"
                android:elevation="0dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/choose_photo"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/soft_background"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:text="@string/ready_for_photo"
            android:textColor="@color/brand_dark"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/photoPreview"
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/photo_preview_background"
            android:contentDescription="@string/photo_preview_description"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detected_carrier"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/carrierText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/waiting"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/carrier_select"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/carrierSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:entries="@array/carrier_options" />

            <LinearLayout
                android:id="@+id/trackingInputGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tracking_confirm"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/trackingInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="textCapCharacters|textMultiLine"
                    android:maxLines="2"
                    android:minHeight="52dp"
                    android:singleLine="false"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fedExMachineGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/fedex_qr_line"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/fedExMachineInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:autofillHints=""
                    android:inputType="number"
                    android:maxLength="34"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/uspsZipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/usps_destination_zip"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/zipInput"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:maxLength="5"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/qr_data"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/qrPayloadText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/waiting_for_tracking"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/bottomQrGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/four_by_six_slots"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fourBySixStepText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/soft_background"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:text="@string/four_by_six_scan_first"
                    android:textColor="@color/brand_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/top_left_qr_slot"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/topSlotPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/photo_preview_background"
                    android:contentDescription="@string/top_label_photo_description"
                    android:padding="8dp"
                    android:scaleType="centerInside" />

                <Button
                    android:id="@+id/takeTopPhotoButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/primary_button_background"
                    android:elevation="0dp"
                    android:text="@string/take_top_label_photo"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topSlotPayloadText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/empty_qr_slot"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/editTopTnoButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/secondary_button_background"
                    android:elevation="0dp"
                    android:text="@string/edit_top_tno"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/bottom_left_qr_slot"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/bottomSlotPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/photo_preview_background"
                    android:contentDescription="@string/bottom_label_photo_description"
                    android:padding="8dp"
                    android:scaleType="centerInside" />

                <Button
                    android:id="@+id/takeBottomPhotoButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/primary_button_background"
                    android:elevation="0dp"
                    android:text="@string/take_bottom_label_photo"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bottomSlotPayloadText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/empty_qr_slot"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/editBottomTnoButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/secondary_button_background"
                    android:elevation="0dp"
                    android:text="@string/edit_bottom_tno"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />

            </LinearLayout>

            <Button
                android:id="@+id/clearAllDataButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/secondary_button_background"
                android:elevation="0dp"
                android:text="@string/clear_all_data"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>

        <ImageView
            android:id="@+id/qrPreview"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/photo_preview_background"
            android:contentDescription="@string/qr_preview_description"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/printButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/primary_button_background"
            android:elevation="0dp"
            android:enabled="false"
            android:text="@string/print_label"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/designerCreditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/designer_credit"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
